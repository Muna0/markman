{
  "mcpServers": {
    "uspto": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/dist/uspto-server.mjs"
      ],
      "env": {
        "USPTO_API_KEY": "${USPTO_API_KEY:-}"
      }
    },
    "wipo": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/dist/wipo-server.mjs"
      ],
      "env": {
        "WIPO_API_KEY": "${WIPO_API_KEY:-}"
      }
    },
    "markman-store": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/dist/markman-store.mjs"
      ]
    }
  }
}
